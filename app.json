{
  "expo": {
    "name": "わりかん生活",
    "slug": "warikan-seikatsu",
    "scheme": "warikan-seikatsu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.yskms.warikanseikatsu",
      "associatedDomains": ["applinks:warikan-seikatsu.app"],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yskms.warikanseikatsu",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "warikan-seikatsu.app", "pathPrefix": "/invite/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "./plugins/withGoogleSignIn.js",
        {
          "iosClientId": "242809187595-8k66s1a1fpd3c244h27vf8jtetq14atc.apps.googleusercontent.com",
          "webClientId": "242809187595-b2rls14sutpaf3difqblstoa7sj2ciq7.apps.googleusercontent.com"
        }
      ],
      "./plugins/withAndroidR8.js",
      "expo-router",
      "expo-apple-authentication",
      ["expo-build-properties", { "ios": { "enableSceneSupport": true } }]
    ],
    "owner": "yskms",
    "extra": {
      "eas": {
        "projectId": "4de331b9-dc4c-42eb-a470-9da44cf28d99"
      }
    }
  }
}
