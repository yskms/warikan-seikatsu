// わりかん生活のバックエンド（Cloudflare Workers + D1）。設計は docs/backend-design.md。
// いまはローカル（wrangler dev。D1は .wrangler/state のローカルDB）だけで使う。
// 本番のWorker・D1・ドメインは、公開の準備のときに作り、ここに書き足す。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warikan-seikatsu",
  "main": "src/index.ts",
  // 上げるときは、wranglerを上げて、動きが変わらないか確かめる。
  "compatibility_date": "2026-11-13",

  // 本番の入口は、独自ドメインだけにする予定（workers.dev とプレビューのURLは出さない）。
  "workers_dev": false,
  "preview_urls": false,

  // 定期処理（月初の脱退の確定など。docs/backend-design.md 7章）。1時間ごと。
  "triggers": {
    "crons": ["0 * * * *"]
  },

  // ログに認証の値を出さないため、Workers Logs は無効のままにする（Singfolioと同じ）。
  "observability": {
    "enabled": false,
    "redact_query_string": true
  },

  // 秘密情報は、このファイルにも、リポジトリにも書かない。本番は `wrangler secret put`、
  // ローカルは .dev.vars（gitignore。.dev.vars.example が見本）。ここに名前を書くと、
  // デプロイの前に、本番に無い秘密情報を検出でき、型（Env）にも出る。
  "secrets": {
    "required": ["NONCE_HMAC_KEY", "APPLE_PRIVATE_KEY"]
  },

  // IDトークンの `aud`（src/idToken.ts の audienceFor）。どれも公開してよい識別子で、秘密情報ではない
  // （アプリに埋め込まれる、またはAppleの設定画面で付けた名前）。Googleのクライアントの `client_secret` は使わない。
  // APPLE_BUNDLE_ID は app.json の ios.bundleIdentifier と同じ（test/config.test.ts が固定している）。
  //
  // GOOGLE_WEB_CLIENT_ID は、まだ作っていない（Google Cloudで、サーバー用（Web）のクライアントIDを作る）。
  // 作るまでは、実在しない値にしてあり、どのGoogleのIDトークンも aud が合わず拒否される（Googleログインは通らない）。
  // 作ったら置き換える（docs/backend-design.md 12章）。
  //
  // APPLE_TEAM_ID・APPLE_KEY_ID は、アカウントの削除（POST /auth/delete）で、iOSの認可コードを交換し、Appleのトークンを失効させるときの
  // `client_secret`（ES256のJWT）に入れる識別子。Team ID はアプリの署名にも入り、Key ID は秘密鍵（.p8。APPLE_PRIVATE_KEY。秘密情報）が
  // 無ければ使えない。どちらも秘密情報ではない。Team ID はSingfolioと同じ開発者アカウントのもの。
  // APPLE_KEY_ID は、Sign in with Apple の鍵をまだ作っていない（Apple Developerで作る）。作るまでは仮の値で、
  // 失効は行われない（削除は止まらない。`appleRevoked: false`）。作ったら置き換える（docs/backend-design.md 12章）。
  // AndroidのAppleログイン（Web経由）に要る APPLE_SERVICES_ID は、そのログインを足すときに加える（同12章）。
  "vars": {
    "APPLE_BUNDLE_ID": "com.yskms.warikanseikatsu",
    "APPLE_TEAM_ID": "3L2FPFG722",
    "APPLE_KEY_ID": "0-not-created-yet",
    "GOOGLE_WEB_CLIENT_ID": "0-not-created-yet.apps.googleusercontent.com"
  },

  // 本番のD1を作るまでは、ローカル専用。database_id は、本番のD1を作ったときにそのIDに置き換える（秘密ではない）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warikan-seikatsu",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
